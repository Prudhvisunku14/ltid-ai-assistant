# Copy to .env. Nothing here is required to browse the dashboard.
# --- URLs ---
PUBLIC_API_URL=http://localhost:8001      # baked into the frontend at build time
CORS_ORIGINS=http://localhost:3000        # comma-separated allowed origins for the API
PROMPT_A_PREVIEW_URL=http://localhost:8000
PROMPT_B_PREVIEW_URL=http://localhost:8002
# --- Optional integrations (never commit real values) ---
OPENAI_API_KEY=
GITHUB_TOKEN=
N8N_WEBHOOK_URL=
